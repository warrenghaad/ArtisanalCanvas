{
  "schemaVersion": "1.0.0",
  "title": "Primitive Engine Rosetta Stone",
  "description": "A cross-disciplinary translation layer that identifies a geometric element, records discipline-specific names, and preserves the construction procedure and invariants.",
  "governingChain": [
    "primitive",
    "motif",
    "transformation",
    "fundamental_region",
    "field",
    "carrier",
    "color_rule",
    "deliberate_defect",
    "explanation"
  ],
  "evidenceLanes": [
    {
      "id": "historical_fact",
      "rule": "Attribute artifact, date, place, material, and documented use."
    },
    {
      "id": "developmental_evidence",
      "rule": "State what research or standards support; do not turn grade bands into ceilings."
    },
    {
      "id": "design_hypothesis",
      "rule": "Mark proposed lessons and interpretations as pedagogical choices."
    }
  ],
  "entities": [
    {
      "id": "source_artifact",
      "type": "evidence_object",
      "required": [
        "title",
        "date_or_range",
        "place_or_people",
        "carrier",
        "source_url",
        "rights_note"
      ]
    },
    {
      "id": "primitive_concept",
      "type": "canonical_geometry",
      "required": [
        "canonical_name",
        "definition",
        "dimensionality",
        "invariants"
      ]
    },
    {
      "id": "discipline_term",
      "type": "alias",
      "required": [
        "discipline",
        "term",
        "construction_emphasis"
      ]
    },
    {
      "id": "construction_recipe",
      "type": "procedure",
      "required": [
        "ordered_operations",
        "prerequisites",
        "verification_tests",
        "failure_signals",
        "recovery_moves"
      ]
    },
    {
      "id": "transformation",
      "type": "operation",
      "required": [
        "operation_family",
        "parameters",
        "preserves",
        "changes"
      ]
    },
    {
      "id": "primitive_cell",
      "type": "generative_seed",
      "required": [
        "boundary",
        "edge_rules",
        "repeat_vectors"
      ]
    },
    {
      "id": "field",
      "type": "generated_structure",
      "required": [
        "local_rule",
        "global_extent",
        "seams"
      ]
    },
    {
      "id": "carrier",
      "type": "material_surface",
      "required": [
        "material",
        "topology",
        "production_constraints"
      ]
    },
    {
      "id": "lesson",
      "type": "curriculum_object",
      "required": [
        "best_home",
        "readiness_signals",
        "artifact_lane",
        "math_lane",
        "studio_cycle",
        "assessment"
      ]
    },
    {
      "id": "visual_asset",
      "type": "raster_evidence",
      "required": [
        "slug",
        "mime_type",
        "sha256",
        "width",
        "height",
        "source_note"
      ]
    }
  ],
  "relationships": [
    {
      "from": "source_artifact",
      "type": "evidences",
      "to": "primitive_concept"
    },
    {
      "from": "discipline_term",
      "type": "aliases_without_collapsing",
      "to": "primitive_concept"
    },
    {
      "from": "construction_recipe",
      "type": "constructs",
      "to": "primitive_concept"
    },
    {
      "from": "transformation",
      "type": "acts_on",
      "to": "primitive_cell"
    },
    {
      "from": "primitive_cell",
      "type": "generates",
      "to": "field"
    },
    {
      "from": "carrier",
      "type": "constrains",
      "to": "field"
    },
    {
      "from": "lesson",
      "type": "stages",
      "to": "construction_recipe"
    },
    {
      "from": "lesson",
      "type": "uses",
      "to": "source_artifact"
    },
    {
      "from": "visual_asset",
      "type": "renders",
      "to": "construction_recipe"
    }
  ],
